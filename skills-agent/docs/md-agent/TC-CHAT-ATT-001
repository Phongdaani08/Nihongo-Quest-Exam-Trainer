> [!WARNING]
> **ข้อกำหนดการสำรองข้อมูล (Backup Required):** เนื่องจากสคริปต์ Migration นี้มีคำสั่ง `DELETE` ข้อมูลแบบถาวร (สำหรับแถวไฟล์แนบเก่าที่ไม่มีความสัมพันธ์กับห้องแชทในปัจจุบัน) **จำเป็นต้องทำการสำรองข้อมูลตาราง `chat_attachments` ก่อนรันคำสั่งย้ายข้อมูลจริงบนสภาพแวดล้อมระบบที่มีข้อมูลจริง** เสมอ เพื่อความปลอดภัย
* **ขั้นตอนที่ 1: เพิ่มคอลัมน์และทำ Backfill ข้อมูลเก่าอย่างปลอดภัย**
  เพิ่มคอลัมน์ `tenant_id` แบบชั่วคราว ดึงข้อมูลจากตาราง `conversations` มาใส่ข้อมูลแถวเก่าทั้งหมด แล้วลบแถวที่ผูกกับห้องแชทที่ถูกลบไปแล้วทิ้ง เพื่อให้เปลี่ยนสถานะเป็น `NOT NULL` ได้อย่างปลอดภัย:
  ```sql
  -- เพิ่มคอลัมน์แบบ nullable ก่อน
  ALTER TABLE chat_attachments ADD COLUMN tenant_id UUID;

  -- ดึงข้อมูล tenant_id เก่าจากตาราง conversations
  UPDATE chat_attachments ca
  SET tenant_id = c.tenant_id
  FROM conversations c
  WHERE ca.conversation_id = c.id;

  -- ลบข้อมูลขยะของไฟล์แนบเก่าที่ไม่ผูกติดกับห้องแชทใดๆ
  DELETE FROM chat_attachments WHERE tenant_id IS NULL;

  -- ตั้งค่าให้เป็น NOT NULL อย่างเป็นทางการ
  ALTER TABLE chat_attachments ALTER COLUMN tenant_id SET NOT NULL;
  ```
* **ขั้นตอนที่ 2: สร้าง Unique Index ระดับตารางแม่**
  ```sql
  ALTER TABLE chat_attachments ADD CONSTRAINT chat_attachments_composite_uq UNIQUE (id, conversation_id, tenant_id);
  ```
* **ขั้นตอนที่ 3: สร้างตารางลูกเก็บ Chunk พร้อม Compound Foreign Key**
  ```sql
  CREATE TABLE chat_attachment_chunks (
      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      attachment_id UUID NOT NULL,
      conversation_id UUID NOT NULL,
      tenant_id UUID NOT NULL,
      content TEXT NOT NULL,
      embedding vector(1024) NOT NULL, -- bge-m3 1024 dims
      created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
      FOREIGN KEY (attachment_id, conversation_id, tenant_id) 
          REFERENCES chat_attachments(id, conversation_id, tenant_id) ON DELETE CASCADE
  );
  CREATE INDEX chat_attachment_chunks_vector_idx ON chat_attachment_chunks 
      USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);
  ```

